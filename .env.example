# ============================================================
# AI Document Chat - Frontend Environment Variables
# ============================================================
# Copy this file to `.env.local` and fill in real values for
# your environment. Never commit `.env.local` to version control.

# Backend API base URL (no trailing slash).
# When the real backend is ready, point this at it; until then,
# the app falls back to the in-app mock service automatically.
VITE_API_BASE_URL=http://localhost:8000/api

# Whether to use the mock API instead of the real backend.
# Set to `false` once a real backend is wired up.
VITE_USE_MOCK_API=true

# Public app name (used in <title>, headers, etc.)
VITE_APP_NAME="AI Document Chat"

# Maximum upload size in megabytes.
VITE_MAX_UPLOAD_MB=10
