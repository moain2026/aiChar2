{
  "name": "ai-document-chat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Production-grade AI Document Chat Frontend - React + TypeScript + Tailwind",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
